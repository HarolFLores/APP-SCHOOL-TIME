rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas de acceso para el perfil y datos académicos de cada estudiante
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email != null);

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users_by_email/{email} {
      allow read, write: if request.auth != null;
    }
  }
}
